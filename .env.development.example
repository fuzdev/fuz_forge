# Development environment
# Copy to .env.development
#
# The dev scripts (`npm run dev:setup` / `dev:reset` / `dev:fuzf` / `dev:server`,
# `gro dev`) use the project's .fuz_forge/ as FUZ_FORGE_HOME, so the
# whole dev forge — the CLI's config and token, and the server's fact + repo
# stores — lives project-local and never collides with a prod-pointed
# ~/.fuz_forge/. (An env file can't expand the project path, so FUZ_FORGE_HOME
# and the project-local FUZ_BOOTSTRAP_TOKEN_PATH come from the scripts, not
# from here.)

# Server
PORT=4041
HOST=127.0.0.1

# Database - PostgreSQL, used by the forge server (backend/web UI)
# Create with: createdb fuz_forge_dev
# NOTE: the CLI never touches the DB — it reads the server URL from
# <FUZ_FORGE_HOME>/config.json (run `npm run dev:fuzf -- init --server http://localhost:4041`).
DATABASE_URL=postgres://localhost/fuz_forge_dev

# Test database (PostgreSQL, required for running tests)
# Create with: createdb fuz_forge_test
TEST_DATABASE_URL=postgres://localhost/fuz_forge_test

# Auth - cookie signing keys (auto-generated by `npm run dev:setup`, or: openssl rand -hex 32)
# For key rotation, separate keys with __ (new_key__old_key)
SECRET_FUZ_COOKIE_KEYS=

# Bootstrap - one-shot token for first-time keeper account creation (auto-created by `npm run dev:setup`)
# After first use, the token file is deleted and this becomes inactive.
# The dev scripts set FUZ_BOOTSTRAP_TOKEN_PATH to .fuz_forge/secret_bootstrap_token
# under the project (the project-local FUZ_FORGE_HOME), so it's not set here.

# Security - allowed origins for API requests
# Patterns: https://fuz.dev, https://*.fuz.dev, http://localhost:* — a wildcard
# boots only with FUZ_ALLOW_ORIGIN_WILDCARDS=true
FUZ_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4041,http://localhost:5174,http://localhost:5175

# Deployment is not configured here — the deploy tasks read .env.production
# (forge) and .env.production.forge2 (forge2); see those .example files.
