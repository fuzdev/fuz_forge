{
	"minimumDependencyAge": { "age": "P1D", "exclude": ["npm:@fuzdev/*", "npm:@ryanatkn/*"] },
	"nodeModulesDir": "manual",
	"exclude": ["**/*.test.ts", "**/*.svelte.ts", "**/*.gen.ts", "src/test/"],
	"tasks": {
		"check": "deno check src/lib/runtime/**/*.ts src/lib/server/**/*.ts src/lib/fuz_forge/**/*.ts"
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 100,
		"indentWidth": 2,
		"singleQuote": true
	}
}
