# forge (<forge-host>) — operator deploy env (Debian 13 / glibc, apt + systemd)
#
# Copy to .env.production (gitignored), fill the blanks, then:
#   deno task apply             # dry-run: preview host convergence
#   deno task apply --wetrun    # converge the host (must pass before deploy)
#   deno task deploy            # dry-run: preview the release (a wetrun runs only a previewed plan)
#   deno task deploy --wetrun   # build -> upload -> swap -> /ready gate
#
# This file is read only by `zap`, to resolve the zap.env('NAME') deferred references in
# zap.ts (DEPLOY_HOST/DEPLOY_USER/DEPLOY_DOMAIN/DEPLOY_CERTBOT_EMAIL and
# SECRET_FUZ_COOKIE_KEYS). It is not the app's runtime env, and the frontend
# reads no env: it reaches the backend on its own origin (`/api/rpc`, `/api/ws`).
#
# The host's own runtime env — app/shared/.env.production — is generated ON
# THE HOST by zap from the config's ENV_TEMPLATE (its variables are listed in
# docs/deploy.md § Operator env files), not copied from here. Another runtime setting (docs/deploy.md § Server env) goes on a host by
# adding it to ENV_TEMPLATE in zap.ts.

# Deploy target — the provisioned Debian VPS.
# DEPLOY_DOMAIN is the forge's public hostname.
DEPLOY_HOST=
DEPLOY_USER=fuz_forge
DEPLOY_DOMAIN=

# Email for Let's Encrypt registration (certbot --email).
DEPLOY_CERTBOT_EMAIL=

# Cookie signing keys — auto-generated by `deno task prod:setup`, or:
#   openssl rand -hex 32
# Rotate by separating keys with __ (new_key__old_key). zap writes this verbatim
# into the host's generated env file; changing it and re-applying rewrites that
# file and restarts fuzfd under the new keys (dropping a key invalidates the
# browser sessions it signed).
SECRET_FUZ_COOKIE_KEYS=
