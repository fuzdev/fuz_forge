{
  "name": "@fuzdev/fuz_forge",
  "version": "0.0.1",
  "description": "a personal-scale forge for self-hosting git repos, signed releases, and files",
  "glyph": "🎛️",
  "logo": "logo.svg",
  "logo_alt": "a friendly orange pixelated spider facing you",
  "license": "0BSD",
  "private": true,
  "homepage": "https://github.com/fuzdev/fuz_forge",
  "repository": "https://github.com/fuzdev/fuz_forge",
  "scripts": {
    "start": "gro dev",
    "dev": "gro dev",
    "build": "gro build",
    "check": "gro check",
    "test": "gro test",
    "preview": "vite preview",
    "dev:setup": "gro task src/tasks/dev_setup.task.ts",
    "dev:reset": "gro task src/tasks/dev_reset.task.ts",
    "dev:server": "NODE_ENV=development FUZ_FORGE_HOME=$PWD/.fuz_forge FUZ_BOOTSTRAP_TOKEN_PATH=$PWD/.fuz_forge/secret_bootstrap_token gro run src/lib/server/server_main.ts --env_file .env.development",
    "dev:fuzf": "FUZ_FORGE_HOME=$PWD/.fuz_forge cargo run --quiet --bin fuzf --",
    "prod:setup": "gro task src/tasks/prod_setup.task.ts",
    "db:status": "gro task src/tasks/db_status.task.ts",
    "apply": "zap apply --env-file .env.production zap.ts",
    "apply:bootstrap": "zap apply --env-file .env.production --bootstrap zap.ts",
    "deploy": "zap deploy --env-file .env.production zap.ts",
    "apply:forge2": "zap apply --env-file .env.production.forge2 zap.forge2.ts",
    "apply:forge2:bootstrap": "zap apply --env-file .env.production.forge2 --bootstrap zap.forge2.ts",
    "deploy:forge2": "zap deploy --env-file .env.production.forge2 zap.forge2.ts",
    "install:fuzf": "cargo build --release --bin fuzf && mkdir -p ~/.local/bin && cp target/release/fuzf ~/.local/bin/fuzf",
    "release": "gro task src/tasks/release.task.ts",
    "benchmark:cross-impl": "gro run src/benchmarks/cross_impl.bench.ts"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#routes/*": "./src/routes/*"
  },
  "engines": {
    "node": ">=24.14"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^3",
    "svelte": "^5"
  },
  "devDependencies": {
    "@fuzdev/blake3-wasm": "^0.2.0",
    "@fuzdev/fuz_app": "^0.176.0",
    "@fuzdev/fuz_code": "^0.59.0",
    "@fuzdev/fuz_css": "^0.81.0",
    "@fuzdev/fuz_schema": "^0.5.6",
    "@fuzdev/fuz_ui": "^0.227.0",
    "@fuzdev/fuz_util": "^0.82.0",
    "@fuzdev/gro": "^0.233.0",
    "@fuzdev/mdz": "^0.9.0",
    "@fuzdev/pglet-wasm": "^0.1.2",
    "@fuzdev/zap": "0.1.0",
    "@hono/bun": "^1.0.1",
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@node-rs/argon2": "^2.2.1",
    "@ryanatkn/eslint-config": "^0.13.2",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/estree": "^1.0.8",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.23.0",
    "hono": "^4.13.16",
    "pg": "^8.23.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-docinfo": "^0.17.0",
    "svelte2tsx": "^0.7.61",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.ts": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.svelte": {
      "types": "./dist/*.svelte.d.ts",
      "svelte": "./dist/*.svelte",
      "default": "./dist/*.svelte"
    },
    "./*.json": {
      "types": "./dist/*.json.d.ts",
      "default": "./dist/*.json"
    }
  }
}
