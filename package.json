{
  "name": "@fuzdev/fuz_forge",
  "version": "0.0.1",
  "description": "a personal-scale forge for self-hosting git repos, signed releases, and files",
  "glyph": "🎛️",
  "logo": "logo.svg",
  "logo_alt": "a friendly orange pixelated spider facing you",
  "license": "0BSD",
  "private": true,
  "homepage": "https://github.com/fuzdev/fuz_forge",
  "repository": "https://github.com/fuzdev/fuz_forge",
  "scripts": {
    "start": "gro dev",
    "dev": "gro dev",
    "build": "gro build",
    "check": "gro check",
    "test": "gro test",
    "preview": "vite preview",
    "serve:node": "gro run src/lib/server/server_node.ts --env_file .env.development",
    "benchmark:cross-impl": "gro run src/benchmarks/cross_impl.bench.ts"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#routes/*": "./src/routes/*"
  },
  "engines": {
    "node": ">=24.14"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^3",
    "svelte": "^5"
  },
  "devDependencies": {
    "@fuzdev/blake3-wasm": "^0.2.0",
    "@fuzdev/fuz_app": "^0.168.1",
    "@fuzdev/fuz_code": "^0.56.0",
    "@fuzdev/fuz_css": "^0.73.0",
    "@fuzdev/fuz_schema": "^0.5.5",
    "@fuzdev/fuz_ui": "^0.222.1",
    "@fuzdev/fuz_util": "^0.79.1",
    "@fuzdev/gro": "^0.224.0",
    "@fuzdev/mdz": "^0.7.0",
    "@fuzdev/pglet-wasm": "^0.1.2",
    "@fuzdev/zap": "../zap",
    "@hono/bun": "^1.0.1",
    "@hono/deno": "^1.0.3",
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@node-rs/argon2": "^2.2.1",
    "@ryanatkn/eslint-config": "^0.13.2",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/deno": "^2.7.0",
    "@types/estree": "^1.0.8",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.23.0",
    "hono": "^4.13.16",
    "pg": "^8.23.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-docinfo": "^0.17.0",
    "svelte2tsx": "^0.7.61",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.ts": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.svelte": {
      "types": "./dist/*.svelte.d.ts",
      "svelte": "./dist/*.svelte",
      "default": "./dist/*.svelte"
    },
    "./*.json": {
      "types": "./dist/*.json.d.ts",
      "default": "./dist/*.json"
    }
  }
}
