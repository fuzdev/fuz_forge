			},
			{
				"input": "%6deta=first&meta=second",
				"expected": "first",
				"note": "keys are percent-decoded before comparison, so an encoded spelling is the same key and competes for first place",
				"key": "meta"
			},
			{
				"input": "meta=a+b%20c",
				"expected": "a b c",
				"note": "`+` is a space in the value; `%20` decodes too",
				"key": "meta"
			},
			{
				"input": "a=1&meta=x&b=2",
				"expected": "x",
				"note": "other keys are ignored, in either position",
