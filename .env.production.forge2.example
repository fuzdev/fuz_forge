# forge2 (<forge2-host>) — operator deploy env (Alpine / musl, apk + OpenRC)
#
# Copy to .env.production.forge2 (gitignored), fill the blanks, then:
#   npm run apply:forge2                # dry-run: preview host convergence
#   npm run apply:forge2 -- --wetrun    # converge the host (must pass before deploy)
#   npm run deploy:forge2               # dry-run: preview the release (a wetrun runs only a previewed plan)
#   npm run deploy:forge2 -- --wetrun   # musl build -> upload -> swap -> /ready gate
#
# Fresh/rebuilt box only (root login disabled + alpine locked out after the first
# apply, so this is a one-time path):
#   npm run apply:forge2:bootstrap              # preview first: a wetrun runs only a previewed plan
#   npm run apply:forge2:bootstrap -- --wetrun
#
# This file is read ONLY by `zap`, to resolve the zap.env('NAME') deferred references in
# zap.forge2.ts. It does NOT configure the app at runtime:
#   - The host's app/shared/.env.production is generated ON THE HOST by zap
#     from the config's ENV_TEMPLATE (variables listed in docs/deploy.md
#     § Operator env files) — not copied from this file.
#   - The frontend reads no env: it reaches the backend on its own origin
#     (`/api/rpc`, `/api/ws`).

# Deploy target — the provisioned Alpine VPS.
# DEPLOY_DOMAIN is the forge's public hostname.
DEPLOY_HOST=
DEPLOY_USER=fuz_forge
DEPLOY_DOMAIN=

# Email for Let's Encrypt registration (certbot --email).
DEPLOY_CERTBOT_EMAIL=

# Stock Alpine cloud-image login user. Used ONLY by `zap apply --bootstrap` on a
# fresh/rebuilt host — bootstrap connects as this, creates fuz_forge, then locks
# it out. The Alpine official cloud image's cloud-init default user is `alpine`.
BOOTSTRAP_USER=alpine

# Cookie signing keys — generate with: openssl rand -hex 32
# Rotate by separating keys with __ (new_key__old_key). zap writes this verbatim
# into the host's generated env file; changing it and re-applying rewrites that
# file and restarts fuzfd under the new keys (dropping a key invalidates the
# browser sessions it signed).
SECRET_FUZ_COOKIE_KEYS=
